# Copie para .env.local e preencha. Em produção, configure na Vercel.

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remetente. Para testes use onboarding@resend.dev; em produção, um e-mail do seu domínio verificado.
RESEND_FROM="Orçamentos LirouDev <onboarding@resend.dev>"

# Destino dos orçamentos
QUOTE_TO_EMAIL=seu-email@exemplo.com

# (Opcional) URL do Google Apps Script Web App para salvar na planilha. Vazio = desativado.
SHEETS_WEBHOOK_URL=
